{
    "name": "sinister-six-chrome-extension",
    "version": "1.0.0",
    "description": "CS 3250 Group 6 Chrome Extension",
    "scripts": {
      "lint": "eslint . --ext .js,.jsx",
      "test": "jest --passWithNoTests",
      "build": "node build.js",
      "dev": "node build.js --watch",
      "docs:api": "jsdoc -c jsdoc.json",
      "prepare": "husky"
    },
    "devDependencies": {
      "@eslint/js": "^10.0.1",
      "eslint": "^10.0.0",
      "globals": "^17.3.0",
      "husky": "^9.1.7",
      "jest": "^29.7.0",
      "jsdoc": "^4.0.5",
      "lint-staged": "^15.2.0"
    },
    "lint-staged": {
      "*.{js,ts,jsx,tsx}": [
        "eslint --fix"
      ]
    },
    "keywords": [
      "chrome-extension"
    ],
    "license": "GPL-3.0"
  }
